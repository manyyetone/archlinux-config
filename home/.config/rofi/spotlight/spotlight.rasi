/**
 * macOS Spotlight
 * Frosted Glass Edition
 */

configuration {
    modi: "drun";
    show-icons: true;
    drun-display-format: "{name}";
    display-drun: "󰍉";
    font: "Inter 13";
}

* {
    bg: #111111AA;
    bg-alt: #20202088;
    fg: #F5F5F7;
    fg-alt: #9A9A9A;
    accent: #FFFFFF10;
}

window {
    transparency: "real";

    location: center;
    anchor: center;

    width: 680px;

    border: 1px;
    border-color: #FFFFFF15;

    border-radius: 24px;

    background-color: #161616D8;
}

mainbox {
    spacing: 16px;
    padding: 18px;

    background-color: transparent;

    children: [
        "inputbar",
        "listview"
    ];
}

inputbar {
    spacing: 14px;

    padding: 14px;

    border: 1px;
    border-color: #FFFFFF15;

    border-radius: 18px;

    background-color: #262626F0;

    children: [
        "prompt",
        "entry"
    ];
}
prompt {
    background-color: transparent;
    text-color: @fg-alt;
}

textbox-prompt-colon {
    enabled: false;
}

entry {
    placeholder: "Search";

    placeholder-color: @fg-alt;

    background-color: transparent;

    text-color: @fg;

    cursor: text;
}

listview {

    columns: 1;

    lines: 7;

    spacing: 4px;

    cycle: true;

    dynamic: true;

    scrollbar: false;

    layout: vertical;

    background-color: transparent;
}

element {

    orientation: horizontal;

    spacing: 14px;

    padding: 10px 14px;

    border-radius: 14px;

    background-color: transparent;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {

    background-color: #FFFFFF14;

    text-color: @fg;
}

element-icon {

    size: 34px;

    background-color: transparent;
}

element-text {

    background-color: transparent;

    text-color: @fg;

    vertical-align: 0.5;

    horizontal-align: 0;
}

textbox {
    background-color: transparent;
    text-color: @fg;
}

error-message {

    padding: 14px;

    border-radius: 16px;

    background-color: @bg-alt;
}