/**
 *
 * Modern Glass Rofi Theme
 * Inspired by macOS Spotlight
 *
 */

configuration {
    modi: "drun";
    show-icons: true;
    display-drun: "󰍉";
    drun-display-format: "{name}";
}

@import "shared/colors.rasi"
@import "shared/fonts.rasi"

window {
    transparency: "real";

    location: center;
    anchor: center;

    width: 920px;

    border: 0px;
    border-radius: 28px;

    background-color: @background;
}

mainbox {
    spacing: 22px;
    padding: 24px;

    background-color: transparent;

    children: [ "inputbar", "listview" ];
}

inputbar {
    spacing: 14px;

    padding: 18px;

    border: 0px;
    border-radius: 18px;

    background-color: @background-alt;

    children: [ "prompt", "entry" ];
}

prompt {
    background-color: transparent;
    text-color: @foreground;
}

textbox-prompt-colon {
    enabled: false;
}

entry {
    placeholder: "Search applications...";
    placeholder-color: #808080;

    background-color: transparent;
    text-color: @foreground;

    cursor: text;
}

listview {
    columns: 5;
    lines: 4;

    cycle: true;
    dynamic: true;

    scrollbar: false;

    layout: vertical;

    spacing: 10px;

    background-color: transparent;
}

element {
    orientation: vertical;

    spacing: 10px;

    padding: 16px;

    border: 0px;
    border-radius: 18px;

    background-color: transparent;
}

element selected.normal {
    background-color: @selected;

    border-radius: 18px;
}

element-icon {
    size: 72px;

    background-color: transparent;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;

    background-color: transparent;

    text-color: @foreground;
}

textbox {
    background-color: transparent;
    text-color: @foreground;
}

error-message {
    padding: 14px;

    border-radius: 18px;

    background-color: @background-alt;
}